# Configuration de l'API Gateway
PORT=8080

# URLs internes des micro-services (noms de services docker-compose)
USER_SERVICE_URL=http://user:8000
MESSAGE_SERVICE_URL=http://message:3000

# Secret JWT : DOIT etre identique a celui du service user
JWT_SECRET=remplace-par-une-chaine-longue-et-aleatoire

# Origine(s) frontend autorisee(s), separees par des virgules.
# Utiliser "*" uniquement en developpement (incompatible avec les credentials).
CORS_ORIGIN=https://messagerie-9fe8b.web.app
