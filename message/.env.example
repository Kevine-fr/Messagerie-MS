# Configuration du service Message
PORT=3000

# MongoDB (stockage des messages)
MONGO_URI=mongodb://mongodb:27017/messages_db

# Kafka (un ou plusieurs brokers separes par des virgules)
KAFKA_URL=kafka:9092

# Origine(s) frontend autorisee(s) pour Socket.IO, separees par des virgules
CORS_ORIGIN=https://messagerie-9fe8b.web.app

# A renseigner UNIQUEMENT pour un broker manage en SASL_SSL (Confluent Cloud, etc.)
KAFKA_API_KEY=
KAFKA_API_SECRET=
