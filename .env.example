# Variables utilisees par docker-compose.prod.yml.
# En production, ce fichier est genere automatiquement par la CI/CD sur le VPS
# a partir des secrets GitHub. Pour un test local de la stack prod : cp .env.example .env

# ---- DockerHub ----
DOCKERHUB_USERNAME=ton-compte-dockerhub
IMAGE_TAG=latest

# ---- Domaine public (reverse proxy nginx) ----
APP_DOMAIN=api.mondomaine.com

# ---- CORS : origine(s) frontend autorisee(s), separees par des virgules ----
CORS_ORIGIN=https://messagerie-9fe8b.web.app

# ---- JWT : DOIT etre identique entre le service user et l'apigateway ----
JWT_SECRET=remplace-par-une-chaine-longue-et-aleatoire

# ---- Laravel (service user) ----
APP_KEY=base64:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=

# ---- MySQL ----
DB_DATABASE=messagerie
DB_PASSWORD=remplace-moi

# ---- Stockage des medias ----
# minio (defaut) ou cloudinary.
MEDIA_DRIVER=minio
# MinIO (S3). MINIO_PUBLIC_URL = URL publique du bucket, servie par nginx
# (sous-domaine -> minio:9000), ex : https://media.mondomaine.com/messagerie
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=remplace-par-un-mot-de-passe-fort
MINIO_BUCKET=messagerie
MINIO_PUBLIC_URL=https://media.mondomaine.com/messagerie
# Utilise uniquement si MEDIA_DRIVER=cloudinary
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ---- Notifications push (Firebase, service message) ----
# Depuis le service account JSON. Laisser vide => push desactivees.
# La cle privee sur UNE ligne, retours a la ligne echappes en \n.
FIREBASE_PROJECT_ID=messagerie-9fe8b
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@messagerie-9fe8b.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Mail ----
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@mondomaine.com
MAIL_FROM_NAME=Messagerie
