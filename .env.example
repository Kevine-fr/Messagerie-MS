# Variables utilisees par docker-compose.prod.yml.
# En production, ce fichier est genere automatiquement par la CI/CD sur le VPS
# a partir des secrets GitHub. Pour un test local de la stack prod : cp .env.example .env

# ---- DockerHub ----
DOCKERHUB_USERNAME=ton-compte-dockerhub
IMAGE_TAG=latest

# ---- Domaine public (reverse proxy nginx) ----
APP_DOMAIN=api.mondomaine.com

# ---- CORS : origine(s) frontend autorisee(s), separees par des virgules ----
CORS_ORIGIN=https://messagerie-9fe8b.web.app

# ---- JWT : DOIT etre identique entre le service user et l'apigateway ----
JWT_SECRET=remplace-par-une-chaine-longue-et-aleatoire

# ---- Laravel (service user) ----
APP_KEY=base64:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=

# ---- MySQL ----
DB_DATABASE=messagerie
DB_ROOT_PASSWORD=remplace-moi

# ---- Cloudinary (upload des photos de profil) ----
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ---- Mail ----
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@mondomaine.com
MAIL_FROM_NAME=Messagerie
