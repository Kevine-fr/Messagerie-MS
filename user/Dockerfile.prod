FROM php:8.2-fpm

RUN apt-get update && apt-get install -y \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libzip-dev \
    libpq-dev \
    git \
    unzip \
    libxml2-dev \
    curl \
    gnupg2 \
    lsb-release \
    librdkafka-dev \
    && rm -rf /var/lib/apt/lists/*

RUN docker-php-ext-install pdo pdo_mysql mysqli

# channel-update : evite "does not have REST dependency information available".
# Version epinglee pour des builds reproductibles.
RUN pecl channel-update pecl.php.net \
    && pecl install rdkafka-6.0.3 \
    && docker-php-ext-enable rdkafka

COPY --from=composer:2.7 /usr/bin/composer /usr/bin/composer

# Limites d'upload (envoi de vidéos / documents via le service média).
RUN { \
      echo "upload_max_filesize=60M"; \
      echo "post_max_size=65M"; \
      echo "memory_limit=256M"; \
      echo "max_execution_time=120"; \
    } > /usr/local/etc/php/conf.d/uploads.ini

WORKDIR /var/www

COPY . .

RUN composer install --no-dev --optimize-autoloader

COPY ./entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8000

CMD ["/entrypoint.sh"]