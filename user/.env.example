APP_NAME=user_service
APP_ENV=local
APP_KEY=base64:nC/xikQlpUhq1l+eTLBLwao56LBBQViMbw5ijuUrXQ0=
APP_DEBUG=true
APP_URL=http://localhost

KAFKA_BROKERS=kafka:9092
KAFKA_GROUP_ID=user-service-group
# Renseigner KAFKA_USERNAME/KAFKA_PASSWORD uniquement pour un broker SASL_SSL (Confluent Cloud, etc.)
KAFKA_USERNAME=
KAFKA_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=messagerie
DB_USERNAME=root
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Stockage des médias (photos de profil + pièces jointes)
# Basculer de fournisseur = changer MEDIA_DRIVER puis renseigner son bloc.
#   MEDIA_DRIVER=cloudinary  -> bloc CLOUDINARY_*
#   MEDIA_DRIVER=minio       -> bloc AWS_* (S3/MinIO, ci-dessous)
# ---------------------------------------------------------------------------
MEDIA_DRIVER=minio
MEDIA_FOLDER=Messagerie-mS
MEDIA_MAX_IMAGE_KB=10240
MEDIA_MAX_VIDEO_KB=51200
MEDIA_MAX_DOCUMENT_KB=20480

# Cloudinary (MEDIA_DRIVER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# S3 / MinIO (MEDIA_DRIVER=minio)
# Pour MinIO : AWS_ENDPOINT=http://minio:9000, AWS_USE_PATH_STYLE_ENDPOINT=true,
# AWS_URL=http(s)://<host-public>/<bucket> pour des URLs publiques.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

JWT_SECRET=
