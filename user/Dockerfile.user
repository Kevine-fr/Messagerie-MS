# Version figée, jamais « 8.2-fpm » : une étiquette flottante ne dit pas
# quelle version tourne, et une image bâtie avant le 19/11/2026 garde les
# failles corrigées par PHP 8.2.36 (injection d'objets par la session
# CVE-2026-115560, use-after-free du fuseau horaire CVE-2026-129496…).
# tests/Unit/ImageDockerTest.php refuse une version antérieure.
FROM php:8.2.36-fpm

# Installation des dépendances système nécessaires à rdkafka et autres extensions
RUN apt-get update && apt-get install -y \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libzip-dev \
    libpq-dev \
    git \
    unzip \
    libxml2-dev \
    curl \
    gnupg2 \
    lsb-release \
    librdkafka-dev \
    && rm -rf /var/lib/apt/lists/*

# Extensions PHP natives
RUN docker-php-ext-install pdo pdo_mysql mysqli

# rdkafka via docker-php-extension-installer (robuste, independant du REST PECL).
ADD https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions /usr/local/bin/
RUN chmod +x /usr/local/bin/install-php-extensions \
    && install-php-extensions rdkafka

# Installation de Composer (version epinglee)
COPY --from=composer:2.7 /usr/bin/composer /usr/bin/composer

# Durcissement de PHP (voir le fichier).
COPY docker/php-securite.ini /usr/local/etc/php/conf.d/zz-securite.ini

# Limites d'upload (envoi de vidéos / documents via le service média).
RUN { \
      echo "upload_max_filesize=110M"; \
      echo "post_max_size=120M"; \
      echo "memory_limit=256M"; \
      echo "max_execution_time=300"; \
    } > /usr/local/etc/php/conf.d/uploads.ini

WORKDIR /var/www
COPY . .

EXPOSE 8000

# Serveur run depuis le docker-compose.yml
# CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000"]
